# ============================================================================
# Screenctl backend — production environment
#
# Nusxa oling:  cp backend.env.example /etc/screenctl/backend.env
# Keyin haqiqiy qiymatlarni to'ldiring va faylni himoyalang:
#   sudo chown root:screenctl /etc/screenctl/backend.env
#   sudo chmod 640 /etc/screenctl/backend.env
# (systemd unit shu faylni EnvironmentFile sifatida o'qiydi)
# ============================================================================

# --- Server ------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Nginx bitta reverse-proxy sifatida oldida turadi. `false` qilsangina
# `trust proxy`ni o'chiradi — odatda kerak emas.
TRUST_PROXY=true

# --- Ma'lumotlar bazasi --------------------------------------------------
# Kuchli parol bilan, docker-compose'dagi dev qiymatlarni ISHLATMANG.
DATABASE_URL=postgresql://screenctl:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/automation_platform

# --- Redis (BullMQ navbatlari + terminal/pty pub-sub) --------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Auth -----------------------------------------------------------------
# Kuchli, tasodifiy qiymat generatsiya qiling, masalan:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS
JWT_EXPIRES_IN=1d

# Statik API_KEY endi ishlatilmaydi — foydalanuvchilar JWT
# (access/refresh token) bilan, device/agent'lar esa DB'da hash'langan
# registration token bilan autentifikatsiya qilinadi.

# --- CORS -------------------------------------------------------------
# Frontend qaysi domenda joylashgan bo'lsa, shu yerga yoziladi.
CORS_ORIGIN=https://app.yourdomain.com

# --- Job execution (ixtiyoriy) --------------------------------------------
# SCRIPT_TIMEOUT_MS=300000
